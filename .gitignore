# Build artifacts
/target/
/fuzz/target/
/bench/target/
/probes/target/
/probes/freestanding/target/
# bench is its own workspace (excluded from the parent because of the
# sibling boringtun path dep); its lockfile is machine-local.
/bench/Cargo.lock

# Fuzzing run state (corpora and crash artifacts are machine-local;
# minimized reproducers should be checked in deliberately as tests)
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Coverage instrumentation output
*.profraw
*.profdata

# Profiler output
perf.data
perf.data.old
flamegraph.svg

# Local reference copy of the whitepaper (third-party document, not code)
/wireguard.pdf

# Python's bytecode cache (the scripts import each other)
__pycache__/

# Editor litter
*.swp
.DS_Store
